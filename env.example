# Frontend Environment Variables
# Copy this file to .env.local and update values as needed

# Shop backend URL (defaults to https://shop-backend-eih5.onrender.com)
NEXT_PUBLIC_SHOP_API_URL=https://shop-backend-eih5.onrender.com

# OMS backend URL, used by the Request for Quotation form (defaults to https://oms-backend-pf2e.onrender.com)
NEXT_PUBLIC_OMS_API_URL=https://oms-backend-pf2e.onrender.com

# For local development, you can override with:
# NEXT_PUBLIC_SHOP_API_URL=http://localhost:5001
# NEXT_PUBLIC_OMS_API_URL=http://localhost:5002
